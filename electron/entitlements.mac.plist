<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron / V8 needs these to run JIT'd JavaScript and load its own dylibs -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Microphone access. Without this, hardened-runtime apps silently fail
       at askForMediaAccess() — TCC never sees the request and the app
       never appears in System Settings → Privacy & Security → Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
